# One deployment per source. SOURCE_ID selects the deployment and the process
# serves every attestation type that source offers. Pick ONE profile below.

# Common
PORT=3120
API_KEYS= # Set with a strong, unique key or keys (each at least 16 characters)

# ── TEE source — serves TeeAvailabilityCheck ──
SOURCE_ID=TEE
RELAY_CONTRACT_ADDRESS=0x051f214D346Cfd97B107BECb87E2B35D1b4287E9
FLARE_RPC_URL=https://coston-api.flare.network/ext/C/rpc
CHAIN_ID=16 # Coston; attested TeeInfo.ChainID must match. Required and non-zero.
TEE_AUDIENCE= # Optional. Expected aud claim on the workload's attestation token. Defaults to "https://sts.google.com" (the audience tee-node requests). Set only if tee-node's audience diverges.
ALLOW_TEE_DEBUG=false # set true to ALSO accept debug-mode TEEs (in addition to production); never enable in production
DISABLE_ATTESTATION_CHECK_E2E=false
ALLOW_PRIVATE_NETWORKS=false

# ── XRP source — serves PMWMultisigAccountConfigured, PMWPaymentStatus, PMWFeeProof ──
SOURCE_ID=testXRP
SOURCE_RPC_URL=https://s.altnet.rippletest.net:51234 # XRPL node (PMWMultisigAccountConfigured)
FLARE_RPC_URL=https://coston-api.flare.network/ext/C/rpc # Flare C-chain RPC (PMWPaymentStatus/PMWFeeProof getInitialNonce)
CCHAIN_DATABASE_URL= # flare c-chain indexer database
SOURCE_DATABASE_URL= # source indexer database (testXRP, ...)
FLARE_TEE_MANAGER_CONTRACT_ADDRESS=0xb7DeFeCfe34f378652Ca5DceB2bF1c01604DEA09
TEE_PAYMENTS_CONTRACT_ADDRESS=0x17fCbAFE3264c57F4CD2CeF376CB86120776dd27 # set per source: TeePayments contract address (getInitialNonce)
