# One deployment per source: SOURCE_ID selects the deployment and the process
# serves every attestation type that source offers.
#
# Uncomment exactly ONE source profile below. Each profile is a separate
# deployment, and the profiles share variable names (SOURCE_ID, FLARE_RPC_URL,
# ...), so leaving two uncommented would silently use whichever comes last.

# Common variables for all sources
PORT=
API_KEYS= # Comma-separated; each key must be at least 16 characters

# ── XRP source ──────────────────────────────────────────────────────────────
# Serves PMWMultisigAccountConfigured, PMWPaymentStatus, PMWFeeProof.
# SOURCE_ID=XRP # or testXRP
# SOURCE_RPC_URL= # Source-chain node (i.e., XRP) — used by PMWMultisigAccountConfigured
# FLARE_RPC_URL=  # Flare C-chain node — used by PMWPaymentStatus/PMWFeeProof (getInitialNonce)
# CCHAIN_DATABASE_URL= # Flare C-Chain indexer database
# SOURCE_DATABASE_URL= # Source indexer database (i.e., XRP, testXRP)
# FLARE_TEE_MANAGER_CONTRACT_ADDRESS= # Contract that emits TeeInstructionsSent events
# TEE_PAYMENTS_CONTRACT_ADDRESS= # Per-source TeePayments contract (getInitialNonce)

# ── BTC source ──────────────────────────────────────────────────────────────
# Serves PMWMultisigUtxoConfigured.
# SOURCE_ID=BTC # or testBTC
# SOURCE_RPC_URL= # Bitcoin Core node — used by PMWMultisigUtxoConfigured (gettxout)

# ── TEE source ──────────────────────────────────────────────────────────────
# Serves TeeAvailabilityCheck.
# SOURCE_ID=TEE
# FLARE_RPC_URL= # Flare RPC
# RELAY_CONTRACT_ADDRESS=
# CHAIN_ID= # EVM chain ID this verifier serves; attested TeeInfo.ChainID must match. Required and non-zero.
# TEE_AUDIENCE= # Optional. Expected aud claim on the workload's attestation token. Defaults to "https://sts.google.com" (the audience tee-node requests). Set only if tee-node's audience diverges.
# ALLOW_TEE_DEBUG=false # set true to ALSO accept debug-mode TEEs (in addition to production); never enable in production
# DISABLE_ATTESTATION_CHECK_E2E=false # Disables attestation checks for E2E tests. Only for test deployments.
# ALLOW_PRIVATE_NETWORKS=false # Allows private/loopback IPs while still blocking dangerous IPs and preserving DNS pinning.
