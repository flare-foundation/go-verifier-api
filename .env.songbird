# One deployment per source. SOURCE_ID selects the deployment and the process
# serves every attestation type that source offers.
#
# Uncomment exactly ONE source profile below. The profiles share variable names
# (SOURCE_ID, FLARE_RPC_URL, ...), so leaving two uncommented would silently use
# whichever comes last.

# Common
PORT=3120
API_KEYS=

# ── TEE source — serves TeeAvailabilityCheck ──
# SOURCE_ID=TEE
# RELAY_CONTRACT_ADDRESS=0xCB86E8Be709001e01897Bf59847406853da8f14b
# RELAY_CUTOVER_CONTRACT_ADDRESS=0xc1BC89b717Af42AE27497C9FFb996002D3AC5031 # redeployed Relay; set together with the epoch below
# RELAY_CUTOVER_STARTING_REWARD_EPOCH=<announced-epoch> # first reward epoch the new Relay serves; use the announced cutover epoch, the same value the other Flare clients are configured with
# FLARE_RPC_URL=<your-songbird-rpc> # your own node advisable; public: https://songbird-api.flare.network/ext/C/rpc
# CHAIN_ID=19
# ALLOW_TEE_DEBUG=false
# DISABLE_ATTESTATION_CHECK_E2E=false
# ALLOW_PRIVATE_NETWORKS=false

# ── XRP source — serves PMWMultisigAccountConfigured, PMWPaymentStatus, PMWFeeProof ──
# SOURCE_ID=XRP
# SOURCE_RPC_URL=<your-source-rpc> # XRPL node (PMWMultisigAccountConfigured); your own node advisable; public: https://s1.ripple.com:51234
# FLARE_RPC_URL=<your-songbird-rpc> # Flare C-chain RPC (PMWPaymentStatus/PMWFeeProof getInitialNonce); public: https://songbird-api.flare.network/ext/C/rpc
# CCHAIN_DATABASE_URL=<songbird-c-chain-db>
# SOURCE_DATABASE_URL=<source-indexer-db>
# FLARE_TEE_MANAGER_CONTRACT_ADDRESS=0x5C2dE0DeFC3FDBbF8e12c12bD0b1629Ed37DC767
# TEE_PAYMENTS_CONTRACT_ADDRESS=0x872119F49021B1d18b42Bc7deE5B4e01d446059E
