# Common variables for all attestation types
PORT=3120
API_KEYS= # Set with a strong, unique key or keys (each at least 16 characters)


# TeeAvailabilityCheck
VERIFIER_TYPE=TeeAvailabilityCheck
SOURCE_ID=TEE
RELAY_CONTRACT_ADDRESS=0xCB86E8Be709001e01897Bf59847406853da8f14b
RPC_URL=https://songbird-api.flare.network/ext/C/rpc
CHAIN_ID=19 # Songbird; attested TeeInfo.ChainID must match. Required and non-zero.
TEE_AUDIENCE= # Optional. Expected aud claim on the workload's attestation token. Defaults to "https://sts.google.com" (the audience tee-node requests). Set only if tee-node's audience diverges.
ALLOW_TEE_DEBUG=false
DISABLE_ATTESTATION_CHECK_E2E=false
ALLOW_PRIVATE_NETWORKS=false

# PMWMultisigAccountConfigured
VERIFIER_TYPE=PMWMultisigAccountConfigured
SOURCE_ID=XRP # set per deployment: source id ( XRP / BTC ...)
RPC_URL=https://s1.ripple.com:51234/ # source RPC (set to the source this verifier serves)


# PMWPaymentStatus
VERIFIER_TYPE=PMWPaymentStatus
SOURCE_ID=XRP # set per deployment: source id ( XRP / BTC ...)
CCHAIN_DATABASE_URL= # flare c-chain indexer database
SOURCE_DATABASE_URL= # source indexer database (XRP / verifier-utxo-indexer for BTC / ...)
FLARE_TEE_MANAGER_CONTRACT_ADDRESS=0x5C2dE0DeFC3FDBbF8e12c12bD0b1629Ed37DC767
TEE_PAYMENTS_CONTRACT_ADDRESS=0x872119F49021B1d18b42Bc7deE5B4e01d446059E # set per source: TeePayments contract address (getInitialNonce)
RPC_URL=https://songbird-api.flare.network/ext/C/rpc # Flare C-chain RPC for getInitialNonce

# PMWFeeProof
VERIFIER_TYPE=PMWFeeProof
SOURCE_ID=XRP # set per deployment: source id ( XRP / BTC ...)
CCHAIN_DATABASE_URL= # flare c-chain indexer database
SOURCE_DATABASE_URL= # source indexer database (XRP / verifier-utxo-indexer for BTC / ...)
FLARE_TEE_MANAGER_CONTRACT_ADDRESS=0x5C2dE0DeFC3FDBbF8e12c12bD0b1629Ed37DC767
TEE_PAYMENTS_CONTRACT_ADDRESS=0x872119F49021B1d18b42Bc7deE5B4e01d446059E # set per source: TeePayments contract address (getInitialNonce)
RPC_URL=https://songbird-api.flare.network/ext/C/rpc # Flare C-chain RPC for getInitialNonce
